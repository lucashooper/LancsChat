PORT=3001
# Comma-separated if you need multiple (e.g. production + preview)
CLIENT_URL=http://localhost:5174

# Supabase — Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Supabase Auth Hook secret (optional) — set same value in Supabase Dashboard → Auth → Hooks
AUTH_HOOK_SECRET=

# Email (optional — Resend)
RESEND_API_KEY=your-resend-api-key

# SQLite — local default is ./lancschat.db (relative to server/)
# Render: mount persistent disk at /var/data and set:
DATABASE_PATH=/var/data/lancschat.db
